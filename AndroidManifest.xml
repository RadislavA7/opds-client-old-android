<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="ru.opds.client"
    android:versionCode="1"
    android:versionName="1.0">

    <uses-sdk android:minSdkVersion="9" android:targetSdkVersion="9" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CatalogActivity"
            android:label="@string/title_catalog"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".SettingsActivity"
            android:label="@string/title_settings"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".BooksActivity"
            android:label="@string/title_books"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".AppSettingsActivity"
            android:label="@string/title_app_settings"
            android:configChanges="orientation|keyboardHidden" />

        <activity
            android:name=".FolderPickerActivity"
            android:label="@string/title_folder_picker"
            android:configChanges="orientation|keyboardHidden" />
    </application>
</manifest>